        { "name": "owners[].lastName", "path": "$.owners[*].lastName", "dataType": "string", "required": true, "cardinality": "array", "sampleValue": "Lopez" }
      ],
      "target": { "name": "Officer/FullName", "path": "/UnderwritingRequest/Officers/Officer/FullName", "dataType": "xs:string", "required": true, "cardinality": "array" },
      "businessConcept": "Principal.FullName",
      "domainPlaybook": "domain/principals@1.0.0",
      "transformation": { "type": "concat", "rule": "firstName + ' ' + lastName, one Officer per owner", "expression": "$.owners[*].(firstName & ' ' & lastName)" },
      "confidencePercent": 90,
      "reasoning": "Owners[] and Officers[] are both principal collections (principals playbook alias). Child fields match on name parts.",
      "evidence": [
        { "kind": "playbook", "reference": "domain/principals@1.0.0", "detail": "Alias Owners ↔ Officers" },
        { "kind": "sample", "reference": "sales-alpha-sample-llc.json", "detail": "2 owners" }
      ],
      "risk": { "sensitivity": "pii" },
      "review": { "status": "autoAccepted" }
    },
    {
