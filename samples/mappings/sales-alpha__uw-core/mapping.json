      "target": { "name": "LegalName", "path": "/UnderwritingRequest/Merchant/LegalName", "dataType": "xs:string", "maxLength": 100, "required": true, "description": "Legal entity name as registered with the state" },
      "businessConcept": "LegalEntity.LegalName",
      "transformation": { "type": "direct", "rule": "Copy; truncate to 100 characters", "expression": "substring($.account.legalName, 0, 100)" },
      "confidencePercent": 98,
      "reasoning": "Exact name match after normalization; both described as the registered legal name.",
      "evidence": [
        { "kind": "sample", "reference": "sales-alpha-sample-llc.json", "detail": "Value is an entity name with legal suffix" },
        { "kind": "documentation", "reference": "UW_Core_Integration_Guide_v4.2.pdf p.6" }
      ],
      "risk": { "dataLoss": "low", "dataLossNote": "Source allows 120 chars, target 100", "targetValidationRules": ["Required", "Max length 100"] },
      "review": { "status": "autoAccepted" }
    },
    {
      "id": "M002",
      "type": "oneToOne",
      "sources": [
        { "name": "dbaName", "path": "$.account.dbaName", "dataType": "string", "maxLength": 80, "required": true, "sampleValue": "Blue Harbor Coffee" }
      ],
      "target": { "name": "DoingBusinessAs", "path": "/UnderwritingRequest/Merchant/DoingBusinessAs", "dataType": "xs:string", "maxLength": 80, "required": true },
      "businessConcept": "LegalEntity.DbaName",
