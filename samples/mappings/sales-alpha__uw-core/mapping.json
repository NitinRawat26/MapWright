      "risk": { "dataLoss": "medium", "dataLossNote": "Wrong unit assumption would under-report ownership 100×", "targetValidationRules": ["Sum of OwnershipPct <= 100"] },
      "review": { "status": "needsReview", "openQuestion": "Confirm with SalesAlpha team that ownershipPercent is always a fraction." }
    },
    {
