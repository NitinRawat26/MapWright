        { "kind": "schema", "reference": "uw-core-request-4.2.xsd", "detail": "pattern [0-9]{9}" }
      ],
      "risk": { "sensitivity": "sensitivePii", "targetValidationRules": ["Required", "Pattern [0-9]{9}"] },
      "review": { "status": "autoAccepted" }
    },
    {
      "id": "M004",
      "type": "derived",
      "sources": [
        { "name": "entityType", "path": "$.account.entityType", "dataType": "string", "required": true, "allowedValues": ["SOLE_PROP", "LLC", "CORP", "PARTNERSHIP", "NON_PROFIT"], "sampleValue": "LLC" }
      ],
      "target": { "name": "TaxIdType", "path": "/UnderwritingRequest/Merchant/TaxId/@type", "dataType": "xs:string", "required": true, "allowedValues": ["SSN", "EIN"] },
      "businessConcept": "LegalEntity.TaxIdType",
      "domainPlaybook": "domain/tax-id@1.0.0",
      "transformation": { "type": "conditional", "rule": "SSN when entity is a sole proprietor, otherwise EIN", "expression": "$.account.entityType = 'SOLE_PROP' ? 'SSN' : 'EIN'", "condition": "entityType = SOLE_PROP" },
      "confidencePercent": 90,
      "reasoning": "SalesAlpha has no explicit tax-id type; tax-id playbook derives it from entity type.",
      "evidence": [
        { "kind": "playbook", "reference": "domain/tax-id@1.0.0", "detail": "Rule TIN-TYPE-01" },
        { "kind": "documentation", "reference": "UW_Core_Integration_Guide_v4.2.pdf p.7" }
      ],
      "review": { "status": "approved", "reviewer": "a.sharma", "reviewedOn": "2026-09-21" }
    },
    {
      "id": "M005",
      "type": "oneToOne",
      "sources": [
        { "name": "entityType", "path": "$.account.entityType", "dataType": "string", "required": true, "allowedValues": ["SOLE_PROP", "LLC", "CORP", "PARTNERSHIP", "NON_PROFIT"], "sampleValue": "LLC" }
      ],
      "target": { "name": "OwnershipType", "path": "/UnderwritingRequest/Merchant/OwnershipType", "dataType": "xs:string", "required": true, "allowedValues": ["SP", "LLC", "C", "P", "NP"] },
      "businessConcept": "LegalEntity.EntityType",
      "domainPlaybook": "domain/entity-type@1.0.0",
      "transformation": {
        "type": "enumMap",
        "rule": "Map SalesAlpha entity codes to UW ownership codes",
        "expression": "lookup(entityTypeMap, $.account.entityType)",
        "valueMap": [
          { "sourceValue": "SOLE_PROP", "targetValue": "SP" },
          { "sourceValue": "LLC", "targetValue": "LLC" },
          { "sourceValue": "CORP", "targetValue": "C", "notes": "Covers both C-Corp and S-Corp; UW Core has no S-Corp code" },
          { "sourceValue": "PARTNERSHIP", "targetValue": "P" },
          { "sourceValue": "NON_PROFIT", "targetValue": "NP" }
        ]
      },
      "confidencePercent": 88,
      "reasoning": "Both fields enumerate legal structure; all 5 source codes have a playbook-known target code.",
      "evidence": [
        { "kind": "fieldSpec", "reference": "SalesAlpha_Field_Dictionary.xlsx row 14" },
        { "kind": "schema", "reference": "uw-core-request-4.2.xsd", "detail": "enumeration SP|LLC|C|P|NP" }
      ],
      "risk": { "dataLoss": "low", "dataLossNote": "S-Corp distinction is lost" },
      "review": { "status": "approved", "reviewer": "a.sharma", "reviewedOn": "2026-09-21", "comments": "S-Corp loss acceptable for UW rules" }
    },
    {
