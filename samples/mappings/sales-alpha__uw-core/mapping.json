      "confidencePercent": 96,
      "reasoning": "Synonym match: DBA = Doing Business As (entity-type playbook alias list).",
      "evidence": [
        { "kind": "playbook", "reference": "domain/entity-type@1.0.0", "detail": "Alias dbaName ↔ DoingBusinessAs" }
      ],
      "risk": { "targetValidationRules": ["Required"] },
      "review": { "status": "autoAccepted" }
    },
    {
      "id": "M003",
      "type": "oneToOne",
      "sources": [
        { "name": "taxId", "path": "$.account.taxId", "dataType": "string", "format": "#########", "required": true, "sampleValue": "*****6789", "description": "SSN for sole proprietors, EIN otherwise" }
      ],
      "target": { "name": "TaxId", "path": "/UnderwritingRequest/Merchant/TaxId/Number", "dataType": "xs:string", "format": "9 digits, no dashes", "required": true },
      "businessConcept": "LegalEntity.TaxId",
      "domainPlaybook": "domain/tax-id@1.0.0",
      "transformation": { "type": "typeCast", "rule": "Strip dashes and spaces", "expression": "replace($.account.taxId, /[^0-9]/, '')" },
      "confidencePercent": 95,
      "reasoning": "Both are the merchant tax identifier; value pattern is 9 digits in all samples.",
