<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\samples\**\*.json;..\..\samples\**\*.xml;..\..\samples\**\*.xsd;..\..\samples\**\*.wsdl;..\..\samples\**\*.csv;..\..\samples\**\*.pdf;..\..\samples\**\*.docx" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\playbooks\**\*.yaml;..\..\playbooks\**\*.yml;..\..\playbooks\**\*.json" LinkBase="playbooks" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MapWright.Ai\MapWright.Ai.csproj" />
    <ProjectReference Include="..\..\src\MapWright.Api\MapWright.Api.csproj" />
    <ProjectReference Include="..\..\src\MapWright.Core\MapWright.Core.csproj" />
    <ProjectReference Include="..\..\src\MapWright.Output\MapWright.Output.csproj" />
    <ProjectReference Include="..\..\src\MapWright.Cli\MapWright.Cli.csproj" />
    <ProjectReference Include="..\..\src\MapWright.Store\MapWright.Store.csproj" />
  </ItemGroup>

</Project>