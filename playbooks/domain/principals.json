{
  "specVersion": "1.0",
  "id": "domain/principals",
  "name": "Principals",
  "kind": "domain",
  "version": "1.0.0",
  "status": "published",
  "owner": "Underwriting BA team",
  "description": "People who own or control the merchant: owners, beneficial owners, officers, signers and guarantors. Similar but not always interchangeable.",
  "changeNotes": [
    {
      "version": "1.0.0",
      "date": "2026-09-25",
      "author": "MapWright starter set",
      "description": "Initial version."
    }
  ],
  "domain": {
    "concept": {
      "name": "Principal",
      "description": "A person who owns or controls the merchant.",
      "cardinality": "array",
      "attributes": [
        {
          "name": "FullName",
          "dataType": "string",
          "sensitivity": "pii",
          "requiresContext": true
        },
        {
          "name": "FirstName",
          "dataType": "string",
          "sensitivity": "pii",
          "requiresContext": true
        },
        {
          "name": "LastName",
          "dataType": "string",
          "sensitivity": "pii",
          "requiresContext": true
        },
        {
          "name": "Title",
          "description": "Job title or role, e.g. CEO, Managing Member.",
          "dataType": "string",
          "requiresContext": true
        },
        {
          "name": "OwnershipPercent",
          "description": "Share of the business the person owns.",
          "dataType": "decimal"
        },
        {
          "name": "Ssn",
          "description": "The person's social security number.",
          "dataType": "string",
          "sensitivity": "sensitivePii"
        },
        {
          "name": "DateOfBirth",
          "dataType": "date",
          "sensitivity": "sensitivePii"
        },
        {
          "name": "Email",
          "dataType": "string",
          "sensitivity": "pii",
          "requiresContext": true
        }
      ]
    },
    "vocabulary": [
      {
        "term": "owners"
      },
      {
        "term": "principals"
      },
      {
        "term": "business owners"
      },
      {
        "term": "beneficial owners",
        "relation": "narrower",
        "note": "Usually owners with 25% or more."
      },
      {
        "term": "ubo",
        "relation": "narrower"
      },
      {
        "term": "officers",
        "relation": "related",
        "note": "Officers run the business but may own nothing."
      },
      {
        "term": "signers",
        "relation": "related"
      },
      {
        "term": "authorized signers",
        "relation": "related"
      },
      {
        "term": "guarantors",
        "relation": "related",
        "note": "Guarantors are liable for losses; they need not be owners."
      },
