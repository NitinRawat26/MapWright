        "term": "e mail",
        "appliesTo": "Email"
      },
      {
        "term": "mail id",
        "appliesTo": "Email"
      }
    ],
    "qualifiers": [
      {
        "name": "unit",
        "description": "Share expressed as a percent (0–100) or a fraction (0–1).",
        "appliesTo": [
          "OwnershipPercent"
        ],
        "values": [
          {
            "value": "fraction",
            "terms": [
              "fraction",
              "ratio",
              "decimal share"
            ],
            "minValue": 0,
            "maxValue": 1
          },
          {
            "value": "percent",
            "terms": [
              "percent",
              "pct",
              "percentage",
              "perc"
            ],
            "minValue": 0,
            "maxValue": 100
          }
        ]
      }
    ],
    "signals": [
      {
        "id": "PRN-SIG-LIST",
        "kind": "cardinality",
        "pattern": "array",
        "weight": 15,
        "note": "principals usually arrive as a list"
      },
      {
        "id": "PRN-SIG-CHILDREN",
        "kind": "childNamePattern",
        "pattern": "^(first|last|full|given|family)_?name$|^ssn$|^dob$|ownership",
        "weight": 15,
        "note": "has person-like children"
      },
      {
        "id": "PRN-SIG-SSN-SHAPE",
        "kind": "valueShape",
        "appliesTo": "Ssn",
        "pattern": "^999-?99-?9999$",
        "weight": 10,
        "note": "nine digits"
      },
      {
        "id": "PRN-SIG-PCT-RANGE",
        "kind": "valueRange",
        "appliesTo": "OwnershipPercent",
        "minValue": 0,
        "maxValue": 100,
        "weight": 10,
        "note": "values between 0 and 100"
      },
      {
        "id": "PRN-SIG-PCT-TEXT",
        "kind": "dataType",
        "appliesTo": "OwnershipPercent",
        "pattern": "string|date|dateTime|boolean",
        "weight": -30,
        "note": "not a number"
      },
      {
        "id": "PRN-SIG-DOB-TYPE",
        "kind": "dataType",
        "appliesTo": "DateOfBirth",
        "pattern": "date|dateTime",
        "weight": 10,
        "note": "a date"
      },
      {
        "id": "PRN-SIG-EMAIL",
        "kind": "valuePattern",
        "appliesTo": "Email",
        "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
        "weight": 10,
        "note": "looks like an e-mail address"
      }
    ],
    "derivations": [
      {
        "id": "PRN-PCT-01",
        "description": "Fraction (0–1) to percent (0–100).",
        "output": {
          "attribute": "OwnershipPercent",
          "qualifiers": {
            "unit": "percent"
          }
        },
        "inputs": [
          {
            "name": "fraction",
            "attribute": "OwnershipPercent",
            "qualifiers": {
              "unit": "fraction"
            }
          }
        ],
        "expression": "fraction * 100",
        "transformation": "unitConversion",
        "examples": [
          {
            "inputs": {
              "fraction": 0.6
            },
            "expected": 60
          },
          {
            "inputs": {
              "fraction": 1
            },
            "expected": 100
          }
        ]
      },
      {
        "id": "PRN-PCT-02",
        "description": "Percent (0–100) to fraction (0–1).",
        "output": {
          "attribute": "OwnershipPercent",
          "qualifiers": {
            "unit": "fraction"
          }
        },
        "inputs": [
          {
            "name": "percent",
            "attribute": "OwnershipPercent",
            "qualifiers": {
              "unit": "percent"
            }
          }
        ],
        "expression": "percent / 100",
        "transformation": "unitConversion",
        "examples": [
          {
            "inputs": {
              "percent": 25
            },
            "expected": 0.25
          }
        ]
      },
      {
        "id": "PRN-NAME-01",
        "description": "Full name is first name, a space, then last name.",
        "output": {
          "attribute": "FullName"
        },
        "inputs": [
          {
            "name": "first",
            "attribute": "FirstName"
          },
          {
            "name": "last",
            "attribute": "LastName"
          }
        ],
        "transformation": "concat"
      },
      {
        "id": "PRN-NAME-02",
        "description": "Split a full name at the last space into first and last name.",
        "output": {
          "attribute": "FirstName"
        },
        "inputs": [
          {
            "name": "full",
            "attribute": "FullName"
          }
        ],
        "transformation": "split",
        "dataLoss": "medium",
        "requiresReview": true,
        "note": "Middle names, suffixes and multi-word surnames split wrongly."
      }
    ],
    "validations": [
      {
        "id": "PRN-VAL-01",
        "description": "Total ownership cannot exceed 100%.",
        "inputs": [
          {
            "name": "ownership",
            "attribute": "OwnershipPercent",
            "qualifiers": {
              "unit": "percent"
            }
          }
        ],
        "expression": "sum(ownership) <= 100",
        "examples": [
          {
            "inputs": {
              "ownership": [
                50,
                30,
                20
              ]
            },
            "expected": true
          },
          {
            "inputs": {
              "ownership": [
                60,
                50
              ]
            },
            "expected": false
          }
        ]
      },
      {
        "id": "PRN-VAL-02",
        "description": "Principals together should own at least 25% (beneficial-ownership rule).",
        "severity": "warning",
        "inputs": [
          {
            "name": "ownership",
            "attribute": "OwnershipPercent",
            "qualifiers": {
              "unit": "percent"
            }
          }
        ],
        "expression": "sum(ownership) >= 25",
        "examples": [
          {
            "inputs": {
              "ownership": [
                10
              ]
            },
            "expected": false
          },
          {
            "inputs": {
              "ownership": [
                100
              ]
            },
            "expected": true
          }
        ]
      }
    ],
    "confidence": {},
    "risks": [
      {
        "id": "PRN-RISK-OFFICER",
        "level": "high",
        "text": "Officers and signers are not automatically owners; sending them as principals can misstate ownership."
      },
      {
        "id": "PRN-RISK-SSN",
        "appliesTo": "Ssn",
        "level": "medium",
        "text": "Sensitive: keep masked in documents and never send unmasked to AI."
      }
    ],
    "reviewGuidance": [
      {
        "id": "PRN-Q-RELATED",
        "when": "nonEquivalentTerm",
        "question": "The system's list is not called owners. Are all of these people beneficial owners (25%+)? If not, which ones should be sent as principals?"
      },
      {
        "id": "PRN-Q-PCT-UNIT",
        "appliesTo": "OwnershipPercent",
        "when": "qualifierConflict",
        "question": "Is ownership sent as a fraction (0–1) or a percent (0–100)?"
      },
      {
        "id": "PRN-Q-PCT-MISSING",
        "appliesTo": "OwnershipPercent",
        "when": "nonEquivalentTerm",
        "question": "Is this really the ownership share, or another percentage?"
      }
    ],
    "aiGuidance": "A principal is a person who owns or controls the merchant. Distinguish owners (hold equity) from officers, signers and guarantors (control or liability, possibly no equity). Never assume an officer is an owner. Ownership may be a fraction (0–1) or a percent (0–100); check observed values.",
    "tests": [
      {
        "id": "PRN-T-01",
        "description": "A JSON owners list is the principal collection.",
        "field": {
          "name": "owners",
          "ancestors": [
            "$"
          ],
          "kind": "object",
          "dataType": "object",
          "cardinality": "array",
          "children": [
            "firstName",
            "lastName",
            "ssn",
            "ownershipPercent"
          ]
        },
        "expect": "Principal",
        "minScore": 85,
        "expectReview": false
      },
      {
        "id": "PRN-T-02",
        "description": "An XML Officer list is principals, but needs review.",
        "field": {
          "name": "Officer",
          "ancestors": [
            "Officers",
            "UnderwritingRequest"
          ],
          "kind": "object",
          "dataType": "object",
          "cardinality": "array",
          "children": [
            "FullName",
            "SSN",
            "OwnershipPct"
          ]
        },
        "expect": "Principal",
        "minScore": 60,
        "expectReview": true
      },
      {
        "id": "PRN-T-03",
        "description": "The wrapper element alone is not enough.",
        "field": {
          "name": "Officers",
          "ancestors": [
            "UnderwritingRequest"
          ],
          "kind": "object",
          "dataType": "object",
          "children": [
            "Officer"
          ]
        },
        "expect": null
      },
      {
        "id": "PRN-T-04",
        "description": "SSN under owners is the principal's SSN.",
        "field": {
          "name": "ssn",
          "ancestors": [
            "owners",
            "$"
          ],
          "valueShapes": [
            "999-99-9999"
          ]
        },
        "expect": "Principal.Ssn",
        "minScore": 90
      },
      {
        "id": "PRN-T-05",
        "description": "Ownership named percent but sent as a fraction.",
        "field": {
          "name": "ownershipPercent",
          "ancestors": [
            "owners",
            "$"
          ],
          "dataType": "decimal",
          "minValue": 0.2,
          "maxValue": 1
        },
        "expect": "Principal.OwnershipPercent",
        "expectQualifiers": {
          "unit": "fraction"
        },
        "expectReview": true
      },
      {
        "id": "PRN-T-06",
        "description": "Ownership sent as a percent.",
        "field": {
          "name": "OwnershipPct",
          "ancestors": [
            "Officer",
            "Officers"
          ],
          "dataType": "integer",
          "minValue": 20,
          "maxValue": 100
        },
        "expect": "Principal.OwnershipPercent",
        "expectQualifiers": {
          "unit": "percent"
        },
        "expectReview": false
      },
      {
        "id": "PRN-T-07",
        "description": "First name needs a principal context.",
        "field": {
          "name": "firstName",
          "ancestors": [
            "owners",
            "$"
          ]
        },
        "expect": "Principal.FirstName",
        "minScore": 80
      },
      {
        "id": "PRN-T-08",
        "description": "A business's legal name is not a principal's name.",
        "field": {
          "name": "legalName",
          "ancestors": [
            "account",
            "$"
          ]
        },
        "expect": null
      },
      {
        "id": "PRN-T-09",
        "description": "Date of birth.",
        "field": {
          "name": "DateOfBirth",
          "ancestors": [
            "Officer",
            "Officers"
          ],
          "dataType": "date"
        },
        "expect": "Principal.DateOfBirth",
        "minScore": 90
      }
    ]
  }
}
