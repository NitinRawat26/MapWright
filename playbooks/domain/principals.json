      },
      {
        "term": "role",
        "appliesTo": "Title",
        "relation": "related"
      },
      {
        "term": "ownership percent",
        "appliesTo": "OwnershipPercent"
      },
      {
        "term": "ownership pct",
        "appliesTo": "OwnershipPercent"
      },
      {
        "term": "ownership percentage",
        "appliesTo": "OwnershipPercent"
