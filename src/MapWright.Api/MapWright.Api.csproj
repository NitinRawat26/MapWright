<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\playbooks\**\*.json" LinkBase="playbooks" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MapWright.Ai\MapWright.Ai.csproj" />
    <ProjectReference Include="..\MapWright.Core\MapWright.Core.csproj" />
    <ProjectReference Include="..\MapWright.Output\MapWright.Output.csproj" />
    <ProjectReference Include="..\MapWright.Store\MapWright.Store.csproj" />
  </ItemGroup>

</Project>
